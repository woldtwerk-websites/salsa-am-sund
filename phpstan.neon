parameters:
  level: max
  paths:
    - web/modules/custom
    - web/themes/custom

  # Test doubles are exercised by running the suite, not by static analysis:
  # the Drupal test base classes leave many properties untyped, which level max
  # reports as noise on every mock.
  excludePaths:
    analyse:
      - web/modules/custom/*/tests/*
      - web/themes/custom/*/tests/*

  # Drupal's own doc comments are regularly wrong about their types — a comment
  # reports its creation time as a string where the interface promises an int —
  # so a condition the annotation calls redundant is still worth checking.
  treatPhpDocTypesAsCertain: false

  drupal:
    # Types config values from the config schema instead of reporting mixed.
    configGetReturnType: true
    rules:
      configGetUnknownKeyRule: true
      pluginManagerInspectionRule: true
