# German translation of the workspace_site module.
#
# English is the source language: the msgids are the literals passed to t(),
# formatPlural() and TranslatableMarkup() in this module's PHP. Imported into
# Drupal's locale storage with:
#
#   drush locale:import de modules/custom/workspace_site/translations/de.po \
#     --type=customized --override=all
#
# Informal "du".
#
msgid ""
msgstr ""
"Project-Id-Version: workspace_site\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: de\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Salsa am Sund – Site"
msgstr "Salsa am Sund – Website"

msgid "Canvas-compatible blocks for the Salsa am Sund site."
msgstr "Canvas-kompatible Blöcke für die Salsa am Sund-Website."

msgid "Please add your last name."
msgstr "Bitte ergänze deinen Nachnamen."

msgid "Please add your first name."
msgstr "Bitte ergänze deinen Vornamen."

msgid "Please add your first and last name."
msgstr "Bitte ergänze deinen Vor- und Nachnamen."

msgid "Complete your registration"
msgstr "Registrierung abschließen"

msgid "Your registration could not be completed. Please sign in again."
msgstr "Deine Registrierung konnte nicht abgeschlossen werden. Bitte melde dich erneut an."

msgid "Your email address comes from @provider. Change it there; it is updated on your next sign-in."
msgstr "Deine E-Mail-Adresse kommt von @provider. Ändere sie dort, sie wird bei deiner nächsten Anmeldung übernommen."

msgid "Approve"
msgstr "Freigeben"

msgid "Approve registration"
msgstr "Registrierung freigeben"

msgid "The account of %name has been approved."
msgstr "Das Konto von %name wurde freigegeben."

msgid "Awaiting approval"
msgstr "Wartet auf Freigabe"

msgid "Whether the account registered itself and waits for an administrator to approve it."
msgstr "Ob sich das Konto selbst registriert hat und auf die Freigabe durch eine Administration wartet."

msgid "Marked the blocked accounts without a login as awaiting approval."
msgstr "Gesperrte Konten ohne Anmeldung wurden als wartend auf Freigabe markiert."

msgid "Approve user registrations"
msgstr "Registrierungen freigeben"

msgid "Approve or delete accounts that registered themselves and await approval."
msgstr "Konten freigeben oder löschen, die sich selbst registriert haben und auf eine Freigabe warten."

msgid "Delete registration"
msgstr "Registrierung löschen"

msgid "Delete the registration of %name?"
msgstr "Möchtest du die Registrierung von %name löschen?"

msgid "View the user list"
msgstr "Benutzerliste ansehen"

msgid "Open the user list under People without being able to edit accounts."
msgstr "Die Benutzerliste unter Personen öffnen, ohne Konten bearbeiten zu können."
