{#
/**
 * @file
 * On-brand status messages.
 *
 * Available variables:
 * - message_list: Messages grouped by type.
 * - status_headings: Human readable heading per message type.
 * - attributes: Attributes for the message wrapper.
 */
#}
{% if message_list is not empty %}
  <div data-drupal-messages class="mb-6 flex flex-col gap-3" role="status" aria-live="polite">
    {% for type, messages in message_list %}
      {% set tone = {
        status: 'border-sea/60 bg-sea-deep/50 text-sand',
        info: 'border-sea/60 bg-sea/10 text-sand',
        warning: 'border-flame-gold/70 bg-flame-gold/10 text-sand',
        error: 'border-flame-red/80 bg-flame-red/15 text-sand',
      } %}
      <div
        class="rounded-xl border-s-4 px-4 py-3 shadow-lg {{ tone[type]|default('border-line bg-ink text-sand') }}"
        {% if type == 'error' or type == 'warning' %}role="alert"{% endif %}
      >
        <h2 class="visually-hidden">{{ status_headings[type]|default(type|t) }}</h2>
        <ul class="m-0 list-none space-y-1 p-0">
          {% for message in messages %}
            <li class="text-sm leading-relaxed">{{ message }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>
{% endif %}
