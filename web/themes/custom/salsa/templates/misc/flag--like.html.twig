{#
/**
 * @file
 * Like flag link rendered as a round heart button.
 *
 * Based on Flag's flag.html.twig. The wrapper keeps Flag's classes because the
 * HTMX link type targets `closest .flag` and Flag's AJAX fallback selects
 * `.js-flag-*`. SalsaHooks sets `heart_effect` from the route of the request
 * that renders this link: the HTMX response for a like pops the heart and pours
 * little hearts, the response for an unlike breaks it. A normal page render has
 * no effect, so the heart only shows its state.
 *
 * Available variables:
 * - attributes: HTML attributes for the link element.
 * - title: The flag link title.
 * - action: 'flag' or 'unflag'.
 * - flag: The flag object.
 * - flaggable: The flaggable entity.
 * - unflag_denied_text: The message shown when unflagging is denied.
 * - heart_effect: 'flag' for a like, 'break' for an unlike, NULL otherwise.
 */
#}
{{ attach_library('flag/flag.link') }}

{% if action == 'unflag' %}
  {% set action_class = 'action-unflag' %}
{% else %}
  {% set action_class = 'action-flag' %}
{% endif %}

{% set classes = [
  'flag',
  'flag-' ~ flag.id()|clean_class,
  'js-flag-' ~ flag.id()|clean_class ~ '-' ~ flaggable.id(),
  action_class,
] %}

{# Set nofollow to prevent search bots from crawling anonymous flag links. #}
{% set attributes = attributes.setAttribute('rel', 'nofollow') %}

{% set heart_effect = heart_effect|default(null) %}
{% set heart_classes = ['salsa-heart'] %}
{% if action == 'unflag' %}
  {% set heart_classes = heart_classes|merge(['salsa-heart--on']) %}
{% endif %}
{% if heart_effect == 'flag' %}
  {% set heart_classes = heart_classes|merge(['salsa-heart--pop']) %}
{% endif %}

{# Each little heart carries its own drift, tilt and delay, so the pour reads
   as a handful of hearts instead of one row leaving in step. #}
{% set pour_particles = [
  {drift: -13, rotate: -18, delay: 0},
  {drift: -4, rotate: 12, delay: 70},
  {drift: 7, rotate: -9, delay: 35},
  {drift: 14, rotate: 15, delay: 120},
  {drift: -8, rotate: 7, delay: 175},
  {drift: 3, rotate: -13, delay: 230},
] %}

<div class="{{ classes|join(' ') }}">
  {% if title %}
  <a{{ attributes }}>
    <span class="relative inline-flex items-center justify-center overflow-visible">
      {{ icon('salsa', 'heart', {size: 20, class: heart_classes|join(' ')}) }}

      {% if heart_effect == 'break' %}
        {# The heart breaks in two: each half is the same heart, clipped to one
           side, moving as one piece over the now empty outline. #}
        <span class="salsa-heart-half salsa-heart-half--left" aria-hidden="true">
          {{ icon('salsa', 'heart', {size: 20}) }}
        </span>
        <span class="salsa-heart-half salsa-heart-half--right" aria-hidden="true">
          {{ icon('salsa', 'heart', {size: 20}) }}
        </span>

        {# A jagged line down the middle, drawn before the halves part. #}
        <svg class="salsa-heart-crack" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3.6 10.7 7.4 13.3 9.7 10.9 12.6 13.1 15.3 11.5 18.6"/>
        </svg>
      {% endif %}

      {% if heart_effect == 'flag' %}
        <span class="salsa-heart-pour" aria-hidden="true">
          {% for particle in pour_particles %}
            <span class="salsa-heart-particle" style="--drift: {{ particle.drift }}px; --rotate: {{ particle.rotate }}deg; --delay: {{ particle.delay }}ms">
              {{ icon('salsa', 'heart', {size: 12}) }}
            </span>
          {% endfor %}
        </span>
      {% endif %}
    </span>
    <span class="sr-only">{{ title }}</span>
  </a>
  {% else %}
  <span>{{ unflag_denied_text }}</span>
  {% endif %}
</div>
