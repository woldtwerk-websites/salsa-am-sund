{#
/**
 * @file
 * Password form element with the view_password toggle inside the field.
 *
 * Same variables as core form-element.html.twig. The wrapper around the input
 * positions the button.shwpd toggle, which view_password inserts after the
 * password input, inside the field on the right. Descriptions are shown as a
 * native popover tooltip next to a visible label.
 *
 * Available variables:
 * - attributes: HTML attributes for the containing element.
 * - children: The rendered form element.
 * - description: Optional description.
 * - disabled: Whether the element is disabled.
 * - errors: Optional error message.
 * - label: The rendered label.
 * - label_display: Label display setting.
 * - prefix, suffix: Optional field prefix and suffix.
 * - type, name: Element type and name.
 *
 * @see form-element.html.twig
 */
#}
{%
  set classes = [
    'js-form-item',
    'form-item',
    'form-type-' ~ type|clean_class,
    'js-form-type-' ~ type|clean_class,
    'form-item-' ~ name|clean_class,
    'js-form-item-' ~ name|clean_class,
    title_display not in ['after', 'before'] ? 'form-no-label',
    disabled == 'disabled' ? 'form-disabled',
    errors ? 'form-item--error',
  ]
%}
{%
  set description_classes = [
    'description',
    description_display == 'invisible' ? 'visually-hidden',
  ]
%}
{%
  set tooltip_classes = [
    'description',
    'm-0 w-max max-w-[min(20rem,calc(100vw-2rem))]! rounded-lg border border-line bg-ink-2 px-3 py-2 text-xs! leading-relaxed text-sand! shadow-lg',
  ]
%}
{% set description_id = description.attributes['id']|default('') %}
{% set tooltip = description.content and description_id and label_display in ['before', 'after'] %}
<div{{ attributes.addClass(classes) }}>
  {% if label_display == 'before' %}
    {% if tooltip %}
      <div class="inline-flex items-center gap-1.5 [&>label]:mb-0!">
        {{ label }}
        <button type="button" commandfor="{{ description_id }}" command="toggle-popover" interestfor="{{ description_id }}" aria-label="{{ 'More information'|t }}" style="anchor-name: --desc-{{ description_id|clean_class }}" class="relative z-10 inline-flex size-5 items-center justify-center rounded-full text-mist hover:text-sand focus-visible:outline-2 focus-visible:outline-flame-gold">
          {{ icon('salsa', 'info', {size: 16}) }}
        </button>
        <div{{ description.attributes.addClass(tooltip_classes).setAttribute('popover', 'auto').setAttribute('role', 'tooltip').setAttribute('style', 'position-anchor: --desc-' ~ description_id|clean_class) }}>
          {{ description.content }}
        </div>
      </div>
    {% else %}
      {{ label }}
    {% endif %}
  {% elseif label_display == 'invisible' %}
    {{ label }}
  {% endif %}
  {% if not tooltip and description_display == 'before' and description.content %}
    <div{{ description.attributes.addClass(description_classes) }}>
      {{ description.content }}
    </div>
  {% endif %}
  {% if prefix is not empty %}
    <span class="field-prefix">{{ prefix }}</span>
  {% endif %}
  <div class="relative [&>button.shwpd]:absolute! [&>button.shwpd]:end-3! [&>button.shwpd]:top-1/2! [&>button.shwpd]:-translate-y-1/2! [&>button.shwpd]:m-0! [&>button.shwpd]:size-6! [&>button.shwpd]:bg-contain [&>button.shwpd]:bg-center [&>button.shwpd]:bg-no-repeat">
    {{ children }}
  </div>
  {% if suffix is not empty %}
    <span class="field-suffix">{{ suffix }}</span>
  {% endif %}
  {% if label_display == 'after' %}
    {% if tooltip %}
      <div class="inline-flex items-center gap-1.5 [&>label]:mb-0!">
        {{ label }}
        <button type="button" commandfor="{{ description_id }}" command="toggle-popover" interestfor="{{ description_id }}" aria-label="{{ 'More information'|t }}" style="anchor-name: --desc-{{ description_id|clean_class }}" class="relative z-10 inline-flex size-5 items-center justify-center rounded-full text-mist hover:text-sand focus-visible:outline-2 focus-visible:outline-flame-gold">
          {{ icon('salsa', 'info', {size: 16}) }}
        </button>
        <div{{ description.attributes.addClass(tooltip_classes).setAttribute('popover', 'auto').setAttribute('role', 'tooltip').setAttribute('style', 'position-anchor: --desc-' ~ description_id|clean_class) }}>
          {{ description.content }}
        </div>
      </div>
    {% else %}
      {{ label }}
    {% endif %}
  {% endif %}
  {% if errors %}
    <div class="form-item--error-message">
      {{ errors }}
    </div>
  {% endif %}
  {% if not tooltip and description_display in ['after', 'invisible'] and description.content %}
    <div{{ description.attributes.addClass(description_classes) }}>
      {{ description.content }}
    </div>
  {% endif %}
</div>
