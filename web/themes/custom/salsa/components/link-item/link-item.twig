{% set is_external = href matches '#^(https?:)?//#' %}

<li class="{{ tw_merge(['group', ui.root|default('')]) }}">
  <a
    href="{{ href }}"
    class="flex items-center justify-between gap-4 py-4 no-underline transition-colors hover:text-[var(--surface-link)]"
    {% if is_external %}target="_blank" rel="noopener noreferrer"{% endif %}
  >
    <span class="min-w-0">
      <span class="block font-body text-base font-semibold md:text-lg">{{ label }}</span>
      {% if description %}
        <span class="mt-0.5 block font-body text-sm text-mist">{{ description }}</span>
      {% endif %}
    </span>

    {% if is_external %}
      {{ icon('salsa', 'external-link', {size: 18, class: 'shrink-0 text-flame-gold'}) }}
    {% else %}
      {{ icon('salsa', 'arrow-right', {size: 18, class: 'shrink-0 text-flame-gold transition-transform duration-200 group-hover:translate-x-1'}) }}
    {% endif %}
  </a>
</li>
