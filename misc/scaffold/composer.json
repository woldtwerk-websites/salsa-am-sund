{
    "name": "workspace/scaffold",
    "extra": {
        "drupal-scaffold": {
            "file-mapping": {
                "[project-root]/.ddev/addon-metadata/frankenphp/manifest.yaml": {
                    "path": "assets/.ddev/addon-metadata/frankenphp/manifest.yaml",
                    "overwrite": true
                },
                "[project-root]/.ddev/config.ai.yaml": {
                    "path": "assets/.ddev/config.ai.yaml",
                    "overwrite": true
                },
                "[project-root]/.ddev/config.frankenphp.yaml": {
                    "path": "assets/.ddev/config.frankenphp.yaml",
                    "overwrite": true
                },
                "[project-root]/.ddev/config.versions.yml": {
                    "path": "assets/.ddev/config.versions.yml",
                    "overwrite": true
                },
                "[project-root]/.ddev/config.vite-devtools.yaml": {
                    "path": "assets/.ddev/config.vite-devtools.yaml",
                    "overwrite": true
                },
                "[project-root]/.ddev/config.vite.yml": {
                    "path": "assets/.ddev/config.vite.yml",
                    "overwrite": true
                },
                "[project-root]/.ddev/docker-compose.frankenphp.yaml": {
                    "path": "assets/.ddev/docker-compose.frankenphp.yaml",
                    "overwrite": true
                },
                "[project-root]/.ddev/web-build/Caddyfile.frankenphp": {
                    "path": "assets/.ddev/web-build/Caddyfile.frankenphp",
                    "overwrite": true
                },
                "[project-root]/.ddev/web-build/Dockerfile.frankenphp": {
                    "path": "assets/.ddev/web-build/Dockerfile.frankenphp",
                    "overwrite": true
                },
                "[project-root]/.ddev/web-build/Dockerfile.pnpm": {
                    "path": "assets/.ddev/web-build/Dockerfile.pnpm",
                    "overwrite": true
                },
                "[project-root]/.ddev/web-build/pre.Dockerfile.frankenphp": {
                    "path": "assets/.ddev/web-build/pre.Dockerfile.frankenphp",
                    "overwrite": true
                },
                "[project-root]/.gitattributes": {
                    "mode": "append",
                    "append": "assets/.gitattributes"
                },
                "[project-root]/.node-version": {
                    "path": "assets/.node-version",
                    "overwrite": true
                },
                "[project-root]/.php-version": {
                    "path": "assets/.php-version",
                    "overwrite": true
                },
                "[project-root]/.vscode/launch.json": {
                    "path": "assets/.vscode/launch.json",
                    "overwrite": false
                },
                "[project-root]/.vscode/settings.json": {
                    "path": "assets/.vscode/settings.json",
                    "overwrite": false
                },
                "[project-root]/.vscode/tasks.json": {
                    "path": "assets/.vscode/tasks.json",
                    "overwrite": false
                },
                "[project-root]/drush/drush.yml": {
                    "path": "assets/drush/drush.yml",
                    "overwrite": true
                },
                "[project-root]/globals.d.ts": {
                    "path": "assets/globals.d.ts",
                    "overwrite": true
                },
                "[project-root]/jsconfig.json": {
                    "path": "assets/jsconfig.json",
                    "overwrite": true
                },
                "[project-root]/package.json": {
                    "path": "assets/package.json",
                    "overwrite": false
                },
                "[project-root]/phpcs.xml.dist": {
                    "path": "assets/phpcs.xml.dist",
                    "overwrite": true
                },
                "[project-root]/phpstan.neon": {
                    "path": "assets/phpstan.neon",
                    "overwrite": true
                },
                "[project-root]/pnpm-workspace.yaml": {
                    "path": "assets/pnpm-workspace.yaml",
                    "overwrite": false
                },
                "[project-root]/skills-lock.json": {
                    "path": "assets/skills-lock.json",
                    "overwrite": true
                },
                "[project-root]/taze.config.js": {
                    "path": "assets/taze.config.js",
                    "overwrite": true
                },
                "[project-root]/tsconfig.json": {
                    "path": "assets/tsconfig.json",
                    "overwrite": true
                }
            }
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
