{
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "module": "esnext",
    // The sources here are served as native ESM by the TypeScript asset
    // optimizer, so they are checked against what the browser runs rather than
    // jsconfig.json's ES6 baseline, which is only right for the plain Drupal
    // behaviours it was written for.
    "target": "esnext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    // Lit's @property/@state are TypeScript's experimental decorators, and its
    // accessors need the pre-standard class field semantics to match.
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": [
    "globals.d.ts",
    "web/themes/custom/**/*.js",
    "web/modules/custom/**/*.js",
    "web/themes/custom/**/*.ts",
    "web/modules/custom/**/*.ts",
  ],
  // The Nuxt layers of the modules are typed by their own tsconfig.json, which
  // hands them to the projects nuxt generates. `exclude` replaces the one
  // in jsconfig.json, so node_modules is repeated. libraries/ holds
  // third-party bundles (the FullCalendar global build), not our code.
  "exclude": [
    "node_modules",
    "**/libraries/**",
    "web/modules/custom/*/nuxt",
  ],
}
