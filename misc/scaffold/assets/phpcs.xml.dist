<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="drupal">
  <description>Coding standards for the custom code of this project.</description>

  <file>web/modules/custom</file>
  <file>web/themes/custom</file>

  <arg name="extensions" value="php,module,install,inc,theme,profile,engine"/>
  <arg name="colors"/>
  <!-- Show the sniff name of every finding, so it can be looked up. -->
  <arg value="sp"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
