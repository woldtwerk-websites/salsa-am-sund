{
  "unocss.underline": true,
  "unocss.languageIds": ["twig", "html"],
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/vendor/*/**": true,
    "**/dist/*/**": true
  },

  /* Exclude from search */
  "search.exclude": {
    "**/dist": true,
    "**/node_modules": true,
    "**/vendor": true,
    "**/libraries": true,
    "**/*.sql": true,
    "**/*.lock": true
  },

  /* Override sdc schema (add Attributes and https://github.com/redhat-developer/vscode-yaml/issues/694) */
  "yaml.schemas": {
    "https://gist.githubusercontent.com/woldtwerk/74fe3d168f6ddab017a6a1aa362c1000/raw/metadata.schema.json": "*.component.yml",
    "./.vscode/drupal-libraries.schema.json": "*.libraries.yml"
  },

  /* General Editor Settings */
  "editor.autoIndent": "advanced",
  "editor.insertSpaces": true,
  "editor.renderWhitespace": "boundary",
  "editor.wordWrapColumn": 130,
  "editor.wordWrap": "off",
  "editor.tabSize": 2,
  "editor.rulers": [130],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "css.validate": false,

  /* File associations */
  "files.associations": {
    "*.inc": "php",
    "*.module": "php",
    "*.install": "php",
    "*.theme": "php",
    "*.test": "php",
    "*.php": "php",
    "*.info": "ini",
    "*.css": "tailwindcss"
  },

  /* Emmet */
  "emmet.includeLanguages": {
    "twig": "html"
  },

  /* Quick Suggest for Tailwind  */
  "editor.quickSuggestions": {
    "strings": true
  },

  "tailwindCSS.classAttributes": ["class", "ui"],
  "tailwindCSS.classFunctions": ["defineAppConfig"],

  "phpcs.enable": true,
  "phpcs.executablePath": "./vendor/bin/phpcs",
  "phpcs.standard": "phpcs.xml.dist",

  "npm.packageManager": "pnpm",

  "intelephense.environment.includePaths": ["web/core/", "web/core/includes", "vendor/"],
  "twigcs.executablePath": "vendor/bin/twigcs",
  "js/ts.experimental.useTsgo": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit"
    }
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file"
  },
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true
}
